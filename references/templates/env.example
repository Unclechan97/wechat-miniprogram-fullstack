# 服务端环境变量模板 —— 复制为 server/.env 后修值（cp env.example .env）
# ⚠️ .env 永不入库（.gitignore）、永不上传云端（白名单暂存 + .dockerignore 双保险）

# ── 本地开发示例值（对应 templates/docker-compose.yml）──────────────
PORT=3000
# 宿主视角：Docker 映射到宿主的端口（3306 常被本机 MySQL 占 → 33061；被占就顺延）
MYSQL_HOST=127.0.0.1:33061
MYSQL_USER=root
MYSQL_PASSWORD=devpassword
MYSQL_DATABASE=myapp

# ── 环境开关 ────────────────────────────────────────────────
# ★ 本地开发打开（允许 X-User-Id 模拟身份）；生产环境必须为 false 或不设置
ALLOW_MOCK_IDENTITY=true

# 开放端点共享密钥（没有"公网直连的开放端点"可留空；见 03 §3.4）
APP_SHARED_KEY=

# ── 第三方服务密钥（按需）───────────────────────────────────
# ZHIPU_API_KEY=
# ASR_APP_ID=
# ASR_SECRET_KEY=
